{
  "sourceLanguage" : "he",
  "strings" : {
    "about.contacts.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheket never sees messages from your contacts. It does not see your calls either: iOS checks each call against the list."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שקט אף פעם לא רואה הודעות מאנשי הקשר שלך. גם את השיחות שלך הוא לא רואה: iOS בודק כל שיחה מול הרשימה."
          }
        }
      }
    },
    "about.privacy.placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy notice: placeholder text, to be replaced with the final wording."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הודעת פרטיות: טקסט זמני, שיוחלף בנוסח הסופי."
          }
        }
      }
    },
    "about.report.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A report sends a random install ID that is not tied to you, your phone number or an advertising ID, the platform, the type (SMS or call), the sender, the message text only if you choose to include it, and the app version."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דיווח שולח מזהה התקנה אקראי שאינו קשור אליך, למספר הטלפון שלך או למזהה פרסום, את הפלטפורמה, את הסוג (SMS או שיחה), את השולח, את תוכן ההודעה רק אם בחרת לצרף אותו, ואת גרסת היישום."
          }
        }
      }
    },
    "about.report.header" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דיווחים"
          }
        }
      }
    },
    "about.retention.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports are deleted after 30 days. Your IP address is not stored."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדיווחים נמחקים לאחר 30 יום. כתובת ה-IP שלך לא נשמרת."
          }
        }
      }
    },
    "about.title" : {
      "extractionState" : "manual",
