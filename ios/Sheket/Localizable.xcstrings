    "about.what.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Election SMS from senders who are not in your contacts are moved to the Junk tab, not deleted. Calls from numbers on the election list are blocked. The list is updated from the server."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הודעות SMS של בחירות משולחים שאינם באנשי הקשר שלך מועברות לתיקיית הזבל, ולא נמחקות. שיחות ממספרים שברשימת הבחירות נחסמות. הרשימה מתעדכנת מהשרת."
          }
        }
      }
    },
