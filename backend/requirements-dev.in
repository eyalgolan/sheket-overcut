# Source for the fully hashed requirements-dev.txt (installed by CI). Runtime
# packages are constrained to the versions in requirements-lock.txt so the
# tests run against exactly what the Lambda layer ships. Regenerate from
# backend/ with:
#   uv pip compile --python-version 3.13 --python-platform x86_64-manylinux2014 --generate-hashes requirements-dev.in -o requirements-dev.txt
-c requirements-lock.txt
-r requirements.txt
