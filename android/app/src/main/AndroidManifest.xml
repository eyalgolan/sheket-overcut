<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The refresh job runs only when a network is available. JobScheduler
         needs ACCESS_NETWORK_STATE for that constraint, or scheduling the job
         in SheketApp.onCreate throws a SecurityException. It is a normal
         permission, so there is no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Spec section 4: contacts are never requested. This strips READ_CONTACTS
         even if a dependency merges it in. -->
    <uses-permission
        android:name="android.permission.READ_CONTACTS"
        tools:node="remove" />

    <application
        android:name=".SheketApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sheket"
        tools:targetApi="31">

        <!-- Spec section 5: the status screen, which is the launcher. -->
        <activity
            android:name=".ui.StatusActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Spec section 5: the about screen. Not exported, so only this app
             can open it. -->
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/about_title" />

        <!-- Spec section 5: the report screen. Not exported, so only this app
             can open it. -->
        <activity
            android:name=".ui.ReportActivity"
            android:exported="false"
            android:label="@string/report_title" />

        <!-- Spec section 7: the periodic blocklist refresh. BIND_JOB_SERVICE
             lets only the system bind it. -->
        <service
            android:name=".data.RefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Spec section 4: the call screening service. BIND_SCREENING_SERVICE
             lets only Telecom bind it. It is asked only about non-contacts,
             because READ_CONTACTS is never held. -->
        <service
            android:name=".screening.SheketScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
